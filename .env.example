# ── Server / API ─────────────────────────────────────────────────────────────
# Secret untuk JWT — WAJIB diganti, string acak panjang (min 32 char)
SECRET_KEY=ganti-dengan-string-acak-panjang
# API key bersama bot monitor & backend (header X-API-Key)
BOT_API_KEY=ganti-juga-ini-api-key
# Origin yang boleh akses CORS (pisah pakai koma)
CORS_ORIGINS=http://localhost:8000,http://127.0.0.1:8000
# URL publik untuk QR absen guru (ganti ke IP LAN/server saat dipakai di HP)
PUBLIC_URL=http://localhost:8000

# ── Password admin per unit (dibuat saat startup) ─────────────────────────────
ADMIN_MI_PASS=ganti-password-admin-mi
ADMIN_MTS_PASS=ganti-password-admin-mts
ADMIN_RA_PASS=ganti-password-admin-ra

# ── Bot Monitor Keamanan (monitor_bot.py) ────────────────────────────────────
MONITOR_TOKEN=ganti-token-bot-telegram-monitor
# Chat ID admin (dapatkan via @userinfobot) — satu-satunya yang bisa pakai menu
CHAT_ID=123456789
# Folder project tempat file kode dipantau file-watcher
PROJECT_DIR=C:\absensi-guru